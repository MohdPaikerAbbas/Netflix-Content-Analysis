      </column>
      <column caption='Release Decade' datatype='string' name='[Calculation_2520129577771008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([release_year] / 10) * 10)&#13;&#10;+ &quot;-&quot;&#13;&#10;+ STR(INT([release_year] / 10) * 10 + 9)' />
